{
  "manifest_version": 3,
  "name": "Twixor — Twitter Growth Extension",
  "version": "1.0.0",
  "description": "Autonomous AI engagement, Score Accelerator, and CrowdFi growth for Twitter/X.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twixor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://twitter.com/*",
        "*://x.com/*"
      ],
      "js": ["prevent-tab-close.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://twitter.com/*",
        "*://x.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "contextMenus",
    "scripting",
    "sidePanel",
    "alarms",
    "debugger",
    "downloads",
    "tabCapture"
  ],
  "host_permissions": [
    "*://twitter.com/*",
    "*://x.com/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["prevent-tab-close.js"],
      "matches": ["*://twitter.com/*", "*://x.com/*"]
    }
  ]
}
